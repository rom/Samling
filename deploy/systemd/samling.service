# Samling - hardened systemd unit.
# Installed by scripts/setup.sh to /etc/systemd/system/samling.service.
# Check the effective sandbox with:  systemd-analyze security samling.service
[Unit]
Description=Samling club management server
Documentation=https://github.com/rom/samling/tree/main/docs
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=samling
Group=samling
ExecStart=/usr/local/bin/samling serve --config /etc/samling/samling.yaml
Restart=on-failure
RestartSec=3
TimeoutStopSec=20

# The master key stays root-only on disk and is handed to the service as a
# credential ($CREDENTIALS_DIRECTORY/master.key, kept in non-swappable memory).
LoadCredential=master.key:/etc/samling/master.key

# --- privileges ---------------------------------------------------------
NoNewPrivileges=yes
# No capabilities at all. To listen on a port below 1024 (e.g. 443) add a
# drop-in (scripts/setup.sh does this for you when --port is below 1024):
#   [Service]
#   AmbientCapabilities=CAP_NET_BIND_SERVICE
#   CapabilityBoundingSet=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077

# --- file system --------------------------------------------------------
# Everything is read-only except the data directory.
ProtectSystem=strict
ReadWritePaths=/var/lib/samling
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectProc=invisible
ProcSubset=pid

# --- kernel -------------------------------------------------------------
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# Pure Go binary (no cgo, no JIT): writable+executable memory is never needed.
MemoryDenyWriteExecute=yes
RemoveIPC=yes

# --- network ------------------------------------------------------------
# AF_UNIX is needed for a local PostgreSQL socket and for logging.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

# --- seccomp ------------------------------------------------------------
# Allow the usual service system calls plus Landlock (the server sandboxes
# itself further after start-up); deny privileged and resource-control calls.
# Denied calls fail with EPERM instead of killing the process.
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=landlock_create_ruleset landlock_add_rule landlock_restrict_self
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM

# --- resources ----------------------------------------------------------
LimitNOFILE=65536
LimitCORE=0
TasksMax=512

[Install]
WantedBy=multi-user.target
